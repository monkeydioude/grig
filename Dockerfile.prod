# Grig: the Go server, its templ pages and the Tailwind CSS in one image.
#
#   docker build -f Dockerfile.prod -t grig .
#   docker run -d --name grig --restart unless-stopped -p 6969:6969 \
#     -v /etc/grig:/etc/grig \
#     -v /etc/systemd/system:/etc/systemd/system \
#     -v /run/dbus/system_bus_socket:/run/dbus/system_bus_socket \
#     grig
#
# Grig edits files of the host, so mount each of them at the same path as on the host:
#   - /etc/grig: grig_server.config.yaml (rewritten at every start, so writable), plus the Josuke
#     and Capybara configs it points to. A path outside /etc/grig needs its own mount.
#   - /etc/systemd/system: the service files, and the symlinks Grig creates there to them.
#   - the D-Bus system socket: Grig restarts services through systemd.
# It runs as root, since systemd only lets root restart units: the container can control the
# host's services. Grig has no login: put it behind a proxy that authenticates, never expose it.
#
# Pages are served under base_path (default /grig); /healthcheck is unprefixed. PORT sets the port.

# ---- CSS: Tailwind scans the templ and Go sources for the classes they use ----
FROM node:22-alpine AS css
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY cmd ./cmd
COPY internal ./internal
COPY pkg ./pkg
COPY static ./static
RUN npx @tailwindcss/cli -i ./static/css/input.css -o ./static/css/output.css --minify

# ---- Back: templ generates the *_templ.go files, then the static binary ----
FROM golang:1.27.1-alpine AS back
# the templ version of go.mod
RUN CGO_ENABLED=0 GOBIN=/out go install github.com/a-h/templ/cmd/templ@v0.3.865
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY cmd ./cmd
COPY internal ./internal
COPY pkg ./pkg
RUN /out/templ generate
RUN CGO_ENABLED=0 go build -ldflags='-s -w' -o /out/grig-server ./cmd/grig-server

# ---- Runtime: the binary, and ./static next to it (served from the working directory) ----
FROM alpine:3.20
RUN apk add --no-cache ca-certificates
WORKDIR /app
COPY --from=back /out/grig-server /usr/local/bin/grig-server
COPY --from=css /app/static ./static

ENV PORT=6969
EXPOSE 6969

CMD ["grig-server", "-c", "/etc/grig/grig_server.config.yaml"]
