package button

import "strings"
import "monkeydioude/grig/pkg/urls"

// Base is the sizing, shape and focus treatment shared by every button,
// so only the colour varies between variants.
const Base = "inline-block rounded px-4 py-2 text-sm font-medium text-gray-100 cursor-pointer border-none transition-colors focus:outline-none focus:ring-2 focus:ring-sky-400/60"

// Colour variants. Callers pick one rather than passing raw colour
// classes, which Tailwind resolves by stylesheet order, not by the order
// they appear in the class attribute.
const (
	Primary   = "bg-sky-500 hover:bg-sky-400"
	Secondary = "bg-slate-700 hover:bg-slate-600"
	Success   = "bg-emerald-500 hover:bg-emerald-600"
	Danger    = "bg-red-500 hover:bg-red-600"
	Warning   = "bg-amber-600 hover:bg-amber-500"
)

var ajaxBlockButtonHandle = templ.NewOnceHandle()

templ editReqJsBlock() {
    @ajaxBlockButtonHandle.Once() {
    <script>
        function EditReq(event) {
            try {
                const length = $_(event.detail.target, "service-block").length;
                const parentName = event.detail.target.getAttribute('data-parent-name');

                event.detail.parameters = {
                    ...event.detail.parameters,
                    index: length,
                    parent_name: parentName,
                }
            } catch (err) {
                console.error(err);
                ToastError("ERROR: Could not display a new block")
            }
        }
    </script>
    }
}

templ AjaxBlockButton(path, target string, class ...string) {
    @editReqJsBlock()
    <button
        type="button"
        hx-get={urls.Path(ctx, path)}
        hx-target={target}
        hx-swap="beforeend"
        hx-on::config-request="EditReq(event)"
        hx-on::after-request="event.stopPropagation()"
        class={Base, Primary, strings.Join(class, " ")}>
        {children...}
    </button>
}

templ AjaxSimplePostUrl(path, successMsg, errMsg string, class ...string) {
    <button
        type="button"
        hx-post={urls.Path(ctx, path)}
        hx-on::after-request="event.stopPropagation();performAnimation(this, event)"
        data-success-msg={successMsg}
        data-error-msg={errMsg}
        class={Base, strings.Join(class, " " )}>
        {children...}
    </button>
}

templ RemoveParentButton(class ...string) {
    <button type="button" class={Base, Danger, strings.Join(class, " ")}
        onclick="removeParent(this)">{children...}</button>
}

templ Remove(target string, class ...string) {
    <button type="button" data-target={target} class={Base, Danger, strings.Join(class, " ")}
        onclick="removeTarget(this)">{children...}</button>
}

templ RemoveLastOf(target string, class ...string) {
    <button type="button" data-target={target} class={Base, Danger, strings.Join(class, " ")}
        onclick="removeLastOf(this)">{children...}</button>
}
