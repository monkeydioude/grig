package kv

// List aligns Row labels and values on a shared grid, so every
// value in a block lines up regardless of label length.
templ List() {
    <dl class="text-sm">
        {children...}
    </dl>
}

templ Row(label, value string) {
    <div class="grid grid-cols-[9rem_1fr] gap-x-4 py-1.5 border-b border-slate-800 last:border-0">
        <dt class="text-sky-500">{label}</dt>
        <dd class="text-slate-200 font-mono break-all">{value}</dd>
    </div>
}

// RowIfSet skips the row entirely when the value is empty, rather
// than showing a label with nothing next to it.
templ RowIfSet(label, value string) {
    if value != "" {
        @Row(label, value)
    }
}
