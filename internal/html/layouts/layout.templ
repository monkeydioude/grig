package layouts

import "monkeydioude/grig/pkg/html/elements"
import "monkeydioude/grig/internal/html/pages"
import "monkeydioude/grig/internal/service/utils"
import "monkeydioude/grig/pkg/urls"

templ navItem(item elements.Link, current bool) {
    <li>
        <a
            class={"px-3 py-2 block text-sm rounded-t transition-colors border-b-2",
                utils.Ternary(current,
                    "text-sky-300 border-sky-400",
                    "text-slate-400 border-transparent hover:text-sky-300 hover:border-slate-600")}
            href={templ.SafeURL(urls.Path(ctx, string(item.Href)))}
            target={item.Target.String()}
            aria-current={utils.Ternary(current, "page", "false")}>{item.Text.String()}</a>
    </li>
}

templ navigation(nav elements.Nav) {
    <div class="container flex items-center gap-6">
        <a class="text-sky-300 font-semibold tracking-tight py-2" href={templ.SafeURL(urls.Path(ctx, "/"))}>grig</a>
        <ul class="flex gap-1">
        for _, item := range nav.Links {
            @navItem(item, item.Href == templ.SafeURL(nav.Current))
        }
        </ul>
    </div>
}

templ Main(nav elements.Nav, page pages.Page) {
    @domInitializer(
        MainJS(),
        MainCSS(),
        page.Title(),
    ) {
        <div class="topbar border-b border-slate-800 bg-slate-900 sticky top-0 z-10">
            @navigation(nav)
        </div>
        <div class="container flex-col py-6">
            @page.Content()
        </div>
    }
}
